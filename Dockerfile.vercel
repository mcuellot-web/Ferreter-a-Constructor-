# Imagen para Vercel (Container Runtime).
# Vercel construye este archivo, lo ejecuta y le envía el tráfico HTTP.
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app
COPY pom.xml .
RUN mvn -q -B dependency:go-offline
COPY src ./src
RUN mvn -q -B -DskipTests package

FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=build /app/target/ferreteria-api-1.0.0.jar app.jar

# Vercel espera el puerto 80 por defecto; la app lee PORT.
ENV PORT=80
EXPOSE 80
ENTRYPOINT ["java", "-jar", "app.jar"]
